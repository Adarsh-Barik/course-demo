.featured-card{
    grid-column:1/-1;
    background:#f8fafc;
    border:2px solid #2563eb;
}

.featured-card:hover{
    background:#eff6ff;
}

.topic-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:20px;
    margin-top:30px;
}

.topic-card{
    border:1px solid #ddd;
    border-radius:10px;
    padding:20px;
    text-align:center;
    text-decoration:none;
    color:inherit;
    transition:0.2s;
}

.topic-card:hover{
    transform:translateY(-4px);
    box-shadow:0 2px 8px rgba(0,0,0,.15);
}

.question-card{
    margin-top:20px;
}

.choice{
    display:block;
    margin:10px 0;
}

pre{
    background:#272822;
    color:white;
    padding:15px;
    border-radius:8px;
    overflow:auto;
}

.correct{
    color:green;
    font-weight:bold;
}

.incorrect{
    color:#cc0000;
    font-weight:bold;
}

.progress-bar{
    height:20px;
    background:#eee;
    border-radius:20px;
}

.progress-fill{
    height:20px;
    width:0%;
    background:#2da44e;
    border-radius:20px;
}

body{
    font-size:18px;
    line-height:1.6;
}

.container{
    max-width:900px;
    margin:auto;
    padding:20px;
}

.question-card{
    background:white;
    border-radius:12px;
    padding:24px;
    margin-top:20px;
    box-shadow:
        0 2px 12px rgba(0,0,0,.08);
}

pre{
    background:#1e293b;
    color:#f8fafc;

    font-size:17px;

    padding:18px;

    border-radius:10px;

    overflow-x:auto;
}

.choice{
    display:block;

    margin:12px 0;

    padding:12px;

    border:1px solid #ddd;

    border-radius:8px;

    cursor:pointer;
}

.choice:hover{
    background:#f8fafc;
}

button{

    font-size:16px;

    padding:12px 24px;

    border:none;

    border-radius:8px;

    background:#2563eb;

    color:white;

    cursor:pointer;
}

.badge{
    display:inline-block;

    padding:6px 12px;

    border-radius:999px;

    color:white;

    font-weight:600;

    margin-bottom:12px;
}

.badge.easy{
    background:#16a34a;
}

.badge.medium{
    background:#ea580c;
}

.badge.hard{
    background:#dc2626;
}

.progress-info{

    font-size:18px;

    font-weight:600;

    margin-bottom:10px;
}
